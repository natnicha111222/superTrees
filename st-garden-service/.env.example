# copy เป็น .env แล้วกรอกค่า — ค่าลับห้าม commit (.env ถูก ignore)
APP_ENV=local
PORT=3003
HOST=127.0.0.1

# Postgres ของ Supabase local — ดูค่าจาก `npx supabase status` ใน st-infra (DB URL)
# MOCK-004: ตอน local ใช้ user postgres ไปก่อน · role เฉพาะ service (garden) ทำใน TASK-003
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:54322/postgres

SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLIC_URL=            # ถ้าเบราว์เซอร์เรียก Storage ผ่าน host อื่น
# service_role / secret key จาก `npx supabase status` — ใช้ฝั่ง server เท่านั้น
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

RABBITMQ_URL=amqp://supertrees:CHANGE_ME@127.0.0.1:5672

# disabled (ค่าเริ่มต้น) | dev-fixed-user (MOCK-002 — local เท่านั้น จนกว่า CONF-002/TASK-003)
AUTH_MODE=dev-fixed-user
# DEV_USER_ID=00000000-0000-4000-8000-000000000001
